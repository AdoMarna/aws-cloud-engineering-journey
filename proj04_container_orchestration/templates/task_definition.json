{
  "family": "fargate-task-definition",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::222971669042:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "containerDefinitions": [
    {
      "name": "my-app",
      "image": "222971669042.dkr.ecr.eu-west-3.amazonaws.com/proj04-app:v2",
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/proj04-app",
          "awslogs-region": "eu-west-3",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ]
    }
  ],
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "tags": [
    {
      "key": "Project",
      "value": "proj04"
    }
  ]
}
